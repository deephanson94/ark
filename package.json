{
  "name": "ark",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "ark": "dist/cli/indexer/cli.js"
  },
  "files": [
    "dist/cli",
    "dist/player",
    "NORTH-STAR.md"
  ],
  "description": "A game that teaches you the shape of an unfamiliar codebase by making you map it.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "npm run index:player && vite",
    "index": "tsx src/indexer/cli.ts .",
    "index:player": "tsx src/indexer/cli.ts . --out src/player/public/atlas.json --quiet",
    "build": "tsc --noEmit && tsc -p tsconfig.player.json --noEmit && npm run index:player && vite build && npm run build:cli",
    "build:cli": "tsc -p tsconfig.cli.json",
    "prepack": "npm run build",
    "holdout": "tsx scripts/holdout.ts",
    "test:pack": "tsx scripts/pack-check.ts",
    "budget": "tsx scripts/budget.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:atlas": "vitest run tests/atlas",
    "test:determinism": "tsx scripts/determinism.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "raster": "tsx scripts/raster.ts",
    "play": "tsx src/indexer/cli.ts play",
    "check:keys": "tsx scripts/check-keys.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "playwright": "^1.62.1",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
