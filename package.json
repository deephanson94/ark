{
  "name": "ark",
  "version": "0.1.0",
  "private": true,
  "description": "A game that teaches you the shape of an unfamiliar codebase by making you map it.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "index": "tsx src/indexer/cli.ts .",
