    "test:atlas": "vitest run tests/atlas",
    "test:determinism": "tsx scripts/determinism.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}